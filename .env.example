APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/novel_generator.db
ARTIFACTS_DIR=./artifacts
SECRET_KEY=change-me-for-public-deployments
LOG_LEVEL=INFO

MAX_CONCURRENT_RUNS=1
WORKER_POLL_INTERVAL_SECONDS=2
RUN_STALE_AFTER_SECONDS=3600
CHAPTER_SUMMARY_WINDOW=4

OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=8192
OLLAMA_STRUCTURED_TEMPERATURE=0.2
OLLAMA_THINK=false
# Optional settings for the focused full-chapter-pair continuity review only.
# Leave unset to inherit normal controls. Tested Gemma 4 12B: true and 1.0.
# OLLAMA_CONTINUITY_THINK=true
# OLLAMA_CONTINUITY_TEMPERATURE=1.0
# Optional controls for independent verification and structural paragraph edits.
# OLLAMA_ADJUDICATION_THINK=true
# OLLAMA_ADJUDICATION_TEMPERATURE=1.0

OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_COMPATIBLE_DEFAULT_MODEL=local-model
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CONTEXT_TOKENS=0
OPENAI_COMPATIBLE_MAX_TOKENS=8192

PROVIDER_CHAT_TIMEOUT_SECONDS=1800
PROVIDER_RETRY_BACKOFF_SECONDS=2

NOVEL_MEMORY_ENABLED=1
NOVEL_MEMORY_MAX_CHARS=14000
NOVEL_MANUSCRIPT_CONTEXT_MAX_CHARS=70000
NOVEL_MANUSCRIPT_QA_CONTEXT_MAX_CHARS=70000
NOVEL_NARRATIVE_LOOKAHEAD_CHAPTERS=3

NOVEL_ARC_CONTEXT_ENABLED=1
NOVEL_ARC_CONTEXT_MAX_CHARS=12000
NOVEL_ARC_DORMANT_AFTER_CHAPTERS=5

NOVEL_CHAPTER_RECALL_ENABLED=1
NOVEL_CHAPTER_RECALL_MAX_CHARS=9000
NOVEL_CHAPTER_RECALL_RECENT=2
NOVEL_CHAPTER_RECALL_RELEVANT=4

NOVEL_ADAPTIVE_LENGTH_ENFORCEMENT=1
NOVEL_ADAPTIVE_LENGTH_MAX_EXTRA_PASSES=1

NOVEL_CONTEXT_HEADROOM_ENABLED=1
NOVEL_CONTEXT_HEADROOM_RESERVE_TOKENS=8192
NOVEL_STAGE_OUTPUT_BUDGETS_ENABLED=1

NOVEL_TRUNCATION_RECOVERY_ENABLED=1
NOVEL_TRUNCATION_MAX_CONTINUATIONS=2
NOVEL_TRUNCATION_CONTEXT_MAX_CHARS=18000

# Autonomous editing: persisted per-chapter attempts (per draft/final phase) and final repair sweeps.
AUTONOMOUS_CHAPTER_REPAIR_ATTEMPTS=12
AUTONOMOUS_PROSE_REPAIR_ATTEMPTS=12
AUTONOMOUS_TARGETED_REPAIR_ATTEMPTS=12
AUTONOMOUS_MANUSCRIPT_REPAIR_ROUNDS=24
AUTONOMOUS_OUTLINE_REPAIR_ATTEMPTS=4
# Optional art direction after accepted manuscript export; no image renderer needed.
GENERATE_COVER_PROMPTS=false
# Automatic autonomous-run recovery after exhausted transport retries; 0 disables.
PROVIDER_RECOVERY_ATTEMPTS=96
# Optional exclusive SQLite worker; local Compose enables this with an OS lock.
# Keep false when using independently managed concurrent workers.
WORKER_EXCLUSIVE=false
